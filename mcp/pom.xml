<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.catools</groupId>
    <artifactId>mcp</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <name>Core Automation Toolset - MCP Root</name>
    <description>The MCP toolset to be used in CATs projects</description>

    <properties>
        <revision>2.0.0-SNAPSHOT</revision>
        <maven.deploy.skip>true</maven.deploy.skip>
        <spotless.skip>true</spotless.skip>
    </properties>

    <modules>
        <module>mcp.parent</module>
        <module>mcp.core</module>
        <module>mcp.server</module>
        <module>mcp.example</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.catools</groupId>
                <artifactId>catools.parent</artifactId>
                <version>${revision}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.catools</groupId>
                <artifactId>mcp.core</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>org.catools</groupId>
                <artifactId>mcp.server</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>org.catools</groupId>
                <artifactId>mcp.web</artifactId>
                <version>${revision}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
